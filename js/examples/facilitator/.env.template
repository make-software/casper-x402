# ============================================================================
# Casper x402 Facilitator (TypeScript) — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment.
# ============================================================================

# ---------------------------------------------------------------------------
# GLOBAL VARIABLES
# ---------------------------------------------------------------------------
# HTTP listen port. Defaults to 4022.
# PORT=4022

# Log level — debug | info | warn | error. Defaults to info.
# LOG_LEVEL=info

# Comma-separated CAIP-2 network IDs this facilitator will accept.
# Each entry must also have its own SECRET_KEY_PEM_<NET>, SECRET_KEY_ALGO_<NET>
# (optional, defaults to ed25519) and RPCURL_<NET> set below.
#
#   casper:casper        -> CASPER_CASPER
#   casper:casper-test   -> CASPER_CASPER_TEST
#   casper:casper-net-1  -> CASPER_CASPER_NET_1
CASPER_NETWORKS=casper:casper-test

# Gas budget (motes) for each settlement transaction; 1 CSPR = 1 000 000 000 motes.
# Defaults to 7000000000.
# TRANSACTION_PAYMENT_MOTES=7000000000

# ---------------------------------------------------------------------------
# PER-NETWORK CONFIGURATION
# ---------------------------------------------------------------------------
# Each network listed in CASPER_NETWORKS above MUST provide its own signing
# key and RPC URL via suffixed env vars. The suffix is the CAIP-2 id uppercased
# with ':' and '-' replaced by '_'.
#
# Startup fails fast with a single error listing every network missing
# either SECRET_KEY_PEM_<NET> or RPCURL_<NET>.

# casper:casper-test
SECRET_KEY_PEM_CASPER_CASPER_TEST="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SECRET_KEY_ALGO_CASPER_CASPER_TEST=ed25519
RPCURL_CASPER_CASPER_TEST=https://node.testnet.casper.network/rpc

# ---------------------------------------------------------------------------
# MULTI-NETWORK EXAMPLE — mainnet + testnet in the same process
# ---------------------------------------------------------------------------
# Uncomment and adapt if CASPER_NETWORKS contains more than one entry.
#
# CASPER_NETWORKS=casper:casper,casper:casper-test
#
# # Mainnet
# SECRET_KEY_PEM_CASPER_CASPER="-----BEGIN PRIVATE KEY-----\n...mainnet key...\n-----END PRIVATE KEY-----"
# SECRET_KEY_ALGO_CASPER_CASPER=ed25519
# RPCURL_CASPER_CASPER=https://node.mainnet.casper.network/rpc
#
# # Testnet
# SECRET_KEY_PEM_CASPER_CASPER_TEST="-----BEGIN PRIVATE KEY-----\n...testnet key...\n-----END PRIVATE KEY-----"
# SECRET_KEY_ALGO_CASPER_CASPER_TEST=secp256k1
# RPCURL_CASPER_CASPER_TEST=https://node.testnet.casper.network/rpc
